# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Configuration multi-environnement automatique
# Ces fichiers sont modifiés automatiquement par les scripts
dev.db
dev-test.db
*.db-journal

# Données locales/de secours : jamais dans le repo (contiennent des hash de mots de passe)
backup-data.json
*.backup.json

# Scripts de test locaux (mots de passe en clair) et bases locales : jamais dans le repo
scripts/test-register*
scripts/test-db.*
prisma/dev.db*
prisma/*.db
prisma/*.db-journal
.claude/
