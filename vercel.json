{
  "buildCommand": "prisma generate && next build",
  "installCommand": "pnpm install",
  "functions": {
    "app/api/audits/[id]/report-pdf/route.ts": {
      "maxDuration": 60
    },
    "app/api/organizations/[id]/monthly-report/route.ts": {
      "maxDuration": 60
    },
    "app/api/client/monthly-report/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 6 * * *"
    }
  ]
}
