generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   // 'admin' | 'user' | 'client' (client = compte rattaché à une organisation, lecture seule)
  audits    Audit[]
  sessions  Session[]
  chatHistories ChatHistory[]
  courseEnrollments CourseEnrollment[]
  quizAttempts QuizAttempt[]
  certifications Certification[]
  progress  LearningProgress[]
  readingSessions ReadingSession[]
  ebookQuizAttempts EbookQuizAttempt[]
  ownedEbooks Ebook[]
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([organizationId])
}

// Client de l'activité InfraCyb (entreprise suivie). Les comptes 'client' y sont rattachés.
model Organization {
  id        String   @id @default(uuid())
  name      String
  sector    String?
  size      String?   // catégorie INSEE-like : 'TPE' | 'PME' | 'ETI' | 'GE'
  headcount Int?      // effectif précis (nombre de salariés)
  annualRevenue Float? // chiffre d'affaires annuel (euros)

  // Périmètre de la mission StratCyber pour ce client (texte libre : ce qui est inclus,
  // ce qui ne l'est pas).
  missionScope String?

  // Test d'applicabilité réglementaire (module A) : indicatif, à confirmer avec un
  // juriste. La transposition française de NIS2 n'est pas finalisée à ce jour.
  nis2Applicability String?   // 'Oui' | 'Non' | 'Incertain'
  nis2Note          String?
  rgpdApplicability String?   // 'Oui' | 'Non'
  rgpdNote          String?
  iso27001Status    String?   // 'Non engagé' | 'En cours' | 'Certifié'
  iso27001Note      String?
  applicabilityAssessedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  audits    Audit[]
  actionPlanItems ActionPlanItem[]
  contacts  Contact[]
  decisions DecisionLogEntry[]
  internalNotes InternalNote[]
  controls  Control[]
  risks     Risk[]
  incidents IncidentCase[]
  vulnerabilities ClientVulnerability[]
  policyDocuments ClientPolicyDocument[]
  securityAnswers SecurityAnswer[]
  governanceMeetings GovernanceMeeting[]
  leadershipTrainings LeadershipTraining[]
  suppliers Supplier[]
}

// Contact côté client (module A). Un seul contact principal par organisation à la fois
// (appliqué par la route, pas par une contrainte de base).
model Contact {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  role           String?  // fonction (ex. "DSI", "Dirigeant")
  email          String?
  phone          String?
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

// Historique des décisions prises avec/pour ce client (ex. "report de la MFA au Q3,
// faute de budget"). Distinct du journal technique ActivityLog (qui trace les actions
// dans l'outil, pas les décisions métier).
model DecisionLogEntry {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  decidedAt      DateTime
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

// Notes internes sur un client : JAMAIS exposées par une route /api/client/*.
model InternalNote {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

// Module B : un contrôle de sécurité compte pour plusieurs référentiels à la fois
// (ex. un contrôle MFA compte pour NIS2, RGPD ET ISO 27001) — `frameworks` est un
// tableau JSON de RegulationScope (voir types/audit.ts), jamais une seule valeur.
model Control {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title       String
  description String?
  frameworks  String   // JSON : string[] (RegulationScope)
  status      String   @default("Non évalué") // 'Conforme' | 'Partiellement conforme' | 'Non conforme' | 'Non applicable' | 'Non évalué'
  owner       String?  // responsable du contrôle (texte libre, cohérent avec le module D)

  evidences Evidence[]
  risks     Risk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// Preuve datée rattachée à un contrôle. Pas de fichier stocké : un lien ou une
// attestation textuelle (voir la contrainte produit : "pas de stockage de fichiers
// pour l'instant"). L'alerte avant expiration est calculée à la volée (expiresAt),
// jamais un statut stocké qui pourrait devenir obsolète.
model Evidence {
  id             String   @id @default(uuid())
  controlId      String
  control        Control  @relation(fields: [controlId], references: [id], onDelete: Cascade)
  organizationId String   // dénormalisé : cloisonnement direct sans jointure jusqu'à Control

  label        String
  source       String?   // d'où vient la preuve (export, capture d'écran, rapport d'audit...)
  owner        String?   // responsable de cette preuve précise (peut différer du responsable du contrôle)
  evidenceDate DateTime  // date de la preuve elle-même
  expiresAt    DateTime?
  link         String?   // lien ou référence vers l'attestation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([controlId])
  @@index([expiresAt])
}

// Module D : action exécutable du plan d'action client (générée depuis un audit, puis
// suivie par l'admin et par le client). Distinct du champ Audit.actionPlan (JSON, ancien
// aperçu en lecture seule du dashboard) : ce modèle est la version structurée et éditable.
model ActionPlanItem {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditId        String?
  audit          Audit?   @relation(fields: [auditId], references: [id], onDelete: SetNull)

  title       String
  description String?
  category    String?  // domaine d'audit (Gouvernance, Technique, RGPD...), informatif
  priority    String   @default("Moyenne") // 'Critique' | 'Haute' | 'Moyenne' | 'Faible'

  // Champs définis par l'admin (le client ne peut pas les modifier)
  responsible    String?   // responsable côté client (texte libre pour l'instant)
  dueDate        DateTime?
  estimatedCost  Float?

  // Champs que le client peut mettre à jour lui-même
  status            String    @default("Non commencé") // 'Non commencé' | 'En cours' | 'Terminé' | 'Bloqué'
  proofOfCompletion String?   // lien ou attestation (pas de stockage de fichier pour l'instant)
  proofDate         DateTime?

  reminders ActionReminder[]
  risks     Risk[]
  vulnerabilities ClientVulnerability[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([auditId])
}

// Relance préparée pour une action en retard : toujours à l'état 'draft' tant que
// l'admin ne l'a pas explicitement approuvée. Pas d'envoi automatique d'email pour
// l'instant (aucun fournisseur d'emailing configuré) : "approuvée" = prête à être
// envoyée manuellement par l'admin, pas livrée automatiquement.
model ActionReminder {
  id               String   @id @default(uuid())
  actionPlanItemId String
  actionPlanItem   ActionPlanItem @relation(fields: [actionPlanItemId], references: [id], onDelete: Cascade)
  organizationId   String   // dénormalisé : évite une jointure pour cloisonner par organisation

  message    String
  status     String    @default("draft") // 'draft' | 'approved' | 'dismissed'
  approvedBy String?
  approvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([actionPlanItemId])
}

// Statut d'avancement d'une action de la feuille de route (avant : stocké en mémoire du serveur, donc perdu).
model ActionStatus {
  id        String   @id @default(uuid())
  userId    String
  actionId  String
  status    String
  progress  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, actionId])
}

// Journal des actions sensibles : qui a fait quoi, quand, sur quel client. Jamais de secret ni de contenu d'audit ici.
model ActivityLog {
  id             String   @id @default(uuid())
  actorId        String?
  actorRole      String?
  action         String
  targetType     String?
  targetId       String?
  organizationId String?
  metadata       String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expires   DateTime
  createdAt DateTime @default(now())
}

model Audit {
  id          String          @id @default(uuid())
  user        User            @relation(fields: [userId], references: [id])
  userId      String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  responses   AuditResponse[]
  report      Report?
  score       Float?
  maturity    String?
  recommendations String?
  companyProfile String?      // Profil de l'entreprise (JSON)
  actionPlan     String?      // Plan d'action généré (JSON)
  roadmapData    String?      // Données de la roadmap (JSON)
  milestones     StrategicMilestone[]
  strategicActions StrategicAction[]
  complianceScores ComplianceScore[]
  legalRiskAssessment LegalRiskAssessment?
  legalRiskScore   Float?      // Score de risque légal calculé
  organizationId   String?     // Client pour lequel l'audit est réalisé
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  sharedWithClient Boolean     @default(false) // visible dans l'espace client seulement si true
  actionPlanItems  ActionPlanItem[]

  @@index([organizationId])
}

model AuditResponse {
  id        String   @id @default(uuid())
  audit     Audit    @relation(fields: [auditId], references: [id])
  auditId   String
  question  String
  category  String
  answer    String
  score     Float?
}

model Report {
  id        String   @id @default(uuid())
  audit     Audit    @relation(fields: [auditId], references: [id])
  auditId   String   @unique
  url       String
  version   Int      @default(1)
  createdAt DateTime @default(now())
}

model Resource {
  id        String   @id @default(uuid())
  type      String   // 'ebook' | 'video' | 'quiz'
  title     String
  url       String
  uploadedAt DateTime @default(now())
}

model Ebook {
  id          String   @id @default(uuid())
  title       String
  author      String
  description String?
  content     String?  // Contenu structuré de l'ebook (JSON)
  url         String?  // URL de téléchargement
  category    String   // 'Fondamentaux' | 'Réseau' | 'Gestion' | 'Cloud' | 'Conformité' | 'Tests'
  difficulty  String   // 'Débutant' | 'Intermédiaire' | 'Avancé'
  duration    String?  // Durée estimée de lecture
  pages       Int?     // Nombre de pages
  rating      Float    @default(0)
  downloads   Int      @default(0)
  tags        String?  // JSON array des tags
  thumbnailUrl String?
  isPublished Boolean  @default(false)

  // Propriétaire : null = catalogue commun ; sinon ebook personnalisé visible par ce seul utilisateur
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  // Relations
  readingSessions ReadingSession[]
  quizzes     EbookQuiz[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
}

// Sessions de lecture pour suivre le progrès
model ReadingSession {
  id          String   @id @default(uuid())
  userId      String
  ebookId     String
  currentPage Int      @default(1)
  progress    Float    @default(0) // Pourcentage 0-100
  timeSpent   Int      @default(0) // en secondes
  completed   Boolean  @default(false)
  lastReadAt  DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id])
  ebook       Ebook    @relation(fields: [ebookId], references: [id])
  
  @@unique([userId, ebookId])
}

// Quiz spécifiques aux ebooks
model EbookQuiz {
  id          String   @id @default(uuid())
  ebookId     String
  title       String
  description String?
  questions   String   // JSON array des questions
  passingScore Int     @default(70)
  
  ebook       Ebook    @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  attempts    EbookQuizAttempt[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EbookQuizAttempt {
  id          String   @id @default(uuid())
  userId      String
  quizId      String
  answers     String   // JSON object avec les réponses
  score       Float
  passed      Boolean
  completedAt DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id])
  quiz        EbookQuiz @relation(fields: [quizId], references: [id])
}

model ChatHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  messages  String
  createdAt DateTime @default(now())
}

// Training Platform Models
model Course {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String   // 'cybersecurity' | 'compliance' | 'strategy'
  level       String   // 'beginner' | 'intermediate' | 'advanced'
  duration    Int      // in minutes
  thumbnailUrl String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  modules     CourseModule[]
  enrollments CourseEnrollment[]
  quizzes     Quiz[]
}

model CourseModule {
  id          String   @id @default(uuid())
  title       String
  description String?
  order       Int
  type        String   // 'video' | 'document' | 'interactive' | 'quiz'
  content     String?  // JSON content or URL
  duration    Int?     // in minutes
  
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  // Relations
  progress    LearningProgress[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CourseEnrollment {
  id          String   @id @default(uuid())
  userId      String
  courseId    String
  enrolledAt  DateTime @default(now())
  completedAt DateTime?
  progress    Float    @default(0) // percentage 0-100
  
  user        User     @relation(fields: [userId], references: [id])
  course      Course   @relation(fields: [courseId], references: [id])
  
  @@unique([userId, courseId])
}

model LearningProgress {
  id        String   @id @default(uuid())
  userId    String
  moduleId  String
  completed Boolean  @default(false)
  timeSpent Int      @default(0) // in seconds
  lastAccessedAt DateTime @default(now())
  
  user      User         @relation(fields: [userId], references: [id])
  module    CourseModule @relation(fields: [moduleId], references: [id])
  
  @@unique([userId, moduleId])
}

model Quiz {
  id          String   @id @default(uuid())
  title       String
  description String?
  courseId    String?
  passingScore Int     @default(70) // percentage
  timeLimit   Int?     // in minutes
  maxAttempts Int      @default(3)
  isActive    Boolean  @default(true)
  
  course      Course?  @relation(fields: [courseId], references: [id])
  questions   QuizQuestion[]
  attempts    QuizAttempt[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model QuizQuestion {
  id          String   @id @default(uuid())
  quizId      String
  question    String
  type        String   // 'multiple_choice' | 'true_false' | 'short_answer'
  options     String?  // JSON array for multiple choice
  correctAnswer String
  explanation String?
  order       Int
  
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String   @id @default(uuid())
  userId      String
  quizId      String
  answers     String   // JSON object with questionId: answer
  score       Float
  passed      Boolean
  startedAt   DateTime @default(now())
  completedAt DateTime?
  
  user        User     @relation(fields: [userId], references: [id])
  quiz        Quiz     @relation(fields: [quizId], references: [id])
}

model Certification {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  category    String   // 'cybersecurity' | 'compliance' | 'strategy'
  issuedAt    DateTime @default(now())
  expiresAt   DateTime?
  certificateUrl String?
  
  user        User     @relation(fields: [userId], references: [id])
}

model ComplianceFramework {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String   // 'GDPR' | 'ISO27001' | 'SOC2' | 'NIST' etc.
  requirements String  // JSON array of requirements
  resources   String?  // JSON array of resource links
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SecurityAlert {
  id          String   @id @default(uuid())
  title       String
  description String
  severity    String   // 'low' | 'medium' | 'high' | 'critical'
  category    String   // 'vulnerability' | 'threat' | 'incident'
  source      String?
  affectedSystems String? // JSON array
  mitigationSteps String? // JSON array
  isResolved  Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Compliance Documentation Platform
model ComplianceDocument {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  content       String   // Rich text content
  summary       String?
  category      String   // 'RGPD' | 'NIS2' | 'DORA' | 'EBIOS' | 'ISO27001' | etc.
  subcategory   String?
  tags          String?  // JSON array
  author        String?
  version       String   @default("1.0")
  status        String   @default("draft") // 'draft' | 'published' | 'archived'
  lastReviewed  DateTime?
  nextReview    DateTime?
  isPublic      Boolean  @default(true)
  
  // Relations
  sections      DocumentSection[]
  templates     DocumentTemplate[]
  actionPlans   ActionPlan[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DocumentSection {
  id          String   @id @default(uuid())
  title       String
  content     String
  order       Int
  level       Int      @default(1) // 1=main, 2=sub, 3=subsub
  
  documentId  String
  document    ComplianceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DocumentTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  content     String   // Template content with placeholders
  category    String
  
  documentId  String?
  document    ComplianceDocument? @relation(fields: [documentId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActionPlan {
  id            String   @id @default(uuid())
  title         String
  description   String?
  category      String   // 'RGPD' | 'NIS2' | 'DORA' | etc.
  priority      String   // 'low' | 'medium' | 'high' | 'critical'
  status        String   @default("planned") // 'planned' | 'in_progress' | 'completed' | 'on_hold'
  startDate     DateTime?
  endDate       DateTime?
  budget        Float?
  responsible   String?  // Person/team responsible
  
  // Relations
  documentId    String?
  document      ComplianceDocument? @relation(fields: [documentId], references: [id])
  tasks         ActionTask[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ActionTask {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("todo") // 'todo' | 'in_progress' | 'completed'
  priority    String   @default("medium")
  dueDate     DateTime?
  assignee    String?
  
  actionPlanId String
  actionPlan   ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ComplianceChecklist {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String   // 'RGPD' | 'NIS2' | 'DORA' | etc.
  
  items       ChecklistItem[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChecklistItem {
  id          String   @id @default(uuid())
  title       String
  description String?
  requirement String?  // Legal requirement reference
  isCompleted Boolean  @default(false)
  evidence    String?  // Evidence/documentation
  notes       String?
  order       Int
  
  checklistId String
  checklist   ComplianceChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RiskAssessment {
  id            String   @id @default(uuid())
  title         String
  description   String?
  methodology  String   // 'EBIOS' | 'ISO27005' | 'NIST' | etc.
  scope         String?
  
  // Risk metrics
  likelihood    Int?     // 1-5 scale
  impact        Int?     // 1-5 scale
  riskLevel     String?  // 'low' | 'medium' | 'high' | 'critical'
  
  // Mitigation
  mitigationPlan String?
  residualRisk   String?
  
  // Relations
  threats       ThreatScenario[]
  vulnerabilities Vulnerability[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ThreatScenario {
  id            String   @id @default(uuid())
  name          String
  description   String
  category      String   // 'cyber' | 'physical' | 'human' | etc.
  likelihood    Int      // 1-5 scale
  impact        Int      // 1-5 scale
  
  assessmentId  String
  assessment    RiskAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Vulnerability {
  id            String   @id @default(uuid())
  name          String
  description   String
  category      String
  severity      String   // 'low' | 'medium' | 'high' | 'critical'
  cvssScore     Float?
  status        String   @default("open") // 'open' | 'mitigated' | 'closed'
  
  assessmentId  String
  assessment    RiskAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PolicyDocument {
  id          String   @id @default(uuid())
  title       String
  type        String   // 'policy' | 'procedure' | 'guideline'
  category    String   // 'security' | 'privacy' | 'compliance'
  content     String
  version     String   @default("1.0")
  status      String   @default("draft")
  approver    String?
  approvedDate DateTime?
  reviewDate  DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IncidentReport {
  id            String   @id @default(uuid())
  title         String
  description   String
  category      String   // 'security' | 'privacy' | 'operational'
  severity      String   // 'low' | 'medium' | 'high' | 'critical'
  status        String   @default("open") // 'open' | 'investigating' | 'resolved' | 'closed'
  
  // Timeline
  detectedAt    DateTime
  reportedAt    DateTime @default(now())
  resolvedAt    DateTime?
  
  // Impact
  affectedSystems String? // JSON array
  dataImpacted    Boolean @default(false)
  personalData    Boolean @default(false)
  
  // Response
  responseActions String?
  rootCause      String?
  preventiveMeasures String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Modèles stratégiques pour les plans d'action et roadmaps connectés aux audits
model StrategicAction {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String   // 'Technique' | 'Organisationnel' | 'Gouvernance' | 'GRC' | etc.
  priority    String   // 'Critique' | 'Haute' | 'Moyenne' | 'Basse'
  status      String   @default("Non commencé") // 'Non commencé' | 'En cours' | 'Terminé' | 'En retard'
  
  // Planning
  startDate   DateTime?
  dueDate     DateTime
  estimatedDuration Int?  // en jours
  
  // Assignation
  owner       String?  // Responsable principal
  assignees   String?  // JSON array des assignés
  
  // Business
  budget      Float?   // Budget estimé
  businessImpact String?
  technicalComplexity String? // 'Faible' | 'Moyenne' | 'Élevée'
  
  // Tracking
  progress    Int      @default(0) // Pourcentage 0-100
  blockers    String?  // JSON array des blocages
  dependencies String? // JSON array des dépendances
  resources   String?  // JSON array des ressources nécessaires
  
  // KPIs et succès
  kpis        String?  // JSON array des indicateurs
  successCriteria String? // JSON array des critères de succès
  notes       String?
  
  // Relations
  auditId     String
  audit       Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  
  // Relations avec les jalons
  milestones  StrategicMilestone[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StrategicMilestone {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String   // Catégorie du jalon
  
  // Status et timing
  status      String   @default("Non commencé") // 'Non commencé' | 'En cours' | 'Terminé'
  dueDate     DateTime
  progress    Int      @default(0) // Pourcentage 0-100
  
  // Relations
  auditId     String
  audit       Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  
  // Actions associées
  actions     StrategicAction[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RoadmapQuarter {
  id          String   @id @default(uuid())
  quarter     String   // 'Q1 2024', 'Q2 2024', etc.
  year        Int
  startDate   DateTime
  endDate     DateTime
  
  // Budget et ressources
  budget      Float?   // Budget alloué au trimestre
  focusAreas  String?  // JSON array des domaines prioritaires
  
  // Objectifs et KPIs
  objectives  String?  // JSON array des objectifs
  kpis        String?  // JSON array des KPIs trimestre
  
  // Relations
  userId      String
  milestones  String?  // JSON array des ID des jalons
  actions     String?  // JSON array des ID des actions
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ComplianceScore {
  id          String   @id @default(uuid())
  regulation  String   // 'RGPD' | 'NIS2' | 'DORA' | 'ISO27001' | etc.
  score       Float    // Score de 0 à 100
  status      String   // 'Critique' | 'À améliorer' | 'Conforme'
  lastUpdated DateTime @default(now())
  
  // Détails de l'évaluation
  details     String?  // JSON avec détails par domaine
  recommendations String? // Recommandations spécifiques
  nextReviewDate DateTime?
  
  // Relations
  auditId     String
  audit       Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LegalRiskAssessment {
  id          String   @id @default(uuid())
  overallScore Float   // Score de risque global 0-100
  riskLevel   String   // 'Faible' | 'Moyen' | 'Élevé' | 'Critique'
  
  // Détails par réglementation
  regulationRisks String? // JSON avec risques détaillés par réglementation
  criticalPoints String? // JSON array des points critiques
  urgentActions String? // JSON array des actions urgentes
  
  // Prédictions et tendances
  trendDirection String? // 'Amélioration' | 'Dégradation' | 'Stable'
  projectedScore Float? // Score projeté dans 6 mois
  
  // Relations
  auditId     String   @unique
  audit       Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Module C : registre des risques vivant, cloisonné par client. Peut optionnellement
// être rattaché à une action du plan (module D) ou à un contrôle (module B) : le
// traitement du risque passe alors concrètement par cette action/ce contrôle.
// Le niveau de risque (probabilité × impact) est calculé à la volée, jamais stocké.
model Risk {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title       String
  description String?
  likelihood  Int      // 1 à 5
  impact      Int      // 1 à 5
  treatment   String   @default("À traiter") // 'Éviter' | 'Réduire' | 'Transférer' | 'Accepter' | 'À traiter'
  owner       String?
  dueDate     DateTime?
  status      String   @default("Ouvert") // 'Ouvert' | 'Traité' | 'Accepté' | 'Clos'

  actionPlanItemId String?
  actionPlanItem   ActionPlanItem? @relation(fields: [actionPlanItemId], references: [id], onDelete: SetNull)
  controlId        String?
  control          Control? @relation(fields: [controlId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// Module C : registre d'incidents avec la procédure de notification NIS2 (alerte
// précoce 24h, notification de l'incident 72h, rapport final 1 mois — article 23 de
// la directive NIS2 ; transposition française non finalisée, voir le profil client).
// Les retards sont calculés à la volée à partir de `detectedAt`, jamais stockés.
model IncidentCase {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title       String
  description String?
  severity    String   @default("Moyenne") // 'Faible' | 'Moyenne' | 'Haute' | 'Critique'
  category    String?
  status      String   @default("Ouvert") // 'Ouvert' | 'En cours' | 'Clos'
  owner       String?

  detectedAt  DateTime  // point de référence des 3 échéances
  earlyWarningSentAt DateTime? // échéance : detectedAt + 24h
  notificationSentAt DateTime? // échéance : detectedAt + 72h
  finalReportSentAt  DateTime? // échéance : detectedAt + 1 mois

  personalDataInvolved Boolean @default(false) // pertinent pour une notification RGPD à la CNIL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// Module C : vulnérabilités par client (distinct du modèle global Vulnerability, qui
// n'a pas de propriétaire — voir les limitations connues du dashboard admin).
model ClientVulnerability {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title       String
  description String?
  severity    String   @default("Moyenne") // 'Faible' | 'Moyenne' | 'Haute' | 'Critique'
  cvssScore   Float?
  status      String   @default("Ouverte") // 'Ouverte' | 'Atténuée' | 'Corrigée'
  discoveredAt DateTime @default(now())

  actionPlanItemId String?
  actionPlanItem   ActionPlanItem? @relation(fields: [actionPlanItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// Module E : catalogue global de modèles de politiques (confidentialité, PSSI,
// sauvegarde, accès, incident, PCA), avec variables {{nom_variable}} à substituer
// pour générer le document final d'un client. Catalogue partagé entre tous les
// clients, pas cloisonné par organisation (ce sont des modèles, pas des documents).
// Contenu "à adapter, à faire relire par un juriste" — jamais du conseil juridique.
model PolicyTemplate {
  id        String   @id @default(uuid())
  type      String   // 'Confidentialité' | 'PSSI' | 'Sauvegarde' | 'Accès' | 'Incident' | 'PCA'
  name      String
  content   String   // texte avec variables au format {{nom_variable}}

  documents ClientPolicyDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Document de politique généré pour un client à partir d'un modèle (variables déjà
// substituées). Versionné : une nouvelle version repart de "Brouillon" et ne touche
// pas l'historique des versions précédentes. La validation est tracée par la
// direction du CLIENT (nom + date renseignés côté serveur au moment de la validation,
// jamais fournis par le corps de la requête — pour que la preuve soit fiable).
model ClientPolicyDocument {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateId     String?
  template       PolicyTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  type    String   // même énumération que PolicyTemplate.type
  title   String
  content String   // contenu final, variables déjà substituées
  version Int      @default(1)
  status  String   @default("Brouillon") // 'Brouillon' | 'À valider' | 'Validé'

  validatedByName String?  // nom du compte client qui a validé (jamais fourni par le client lui-même dans le corps de la requête)
  validatedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, type])
}

// Module F : bibliothèque de réponses aux questionnaires de sécurité (clients grands
// comptes, assureurs). Chaque réponse est datée et honnête ; un "non applicable" doit
// toujours être motivé (vérifié côté route, jamais de N/A silencieux). Validation
// tracée par la direction du client, même mécanique que le module E (ClientPolicyDocument) :
// le statut "Validé" n'est posé que par le client, nom et date fixés côté serveur.
model SecurityAnswer {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  question String
  answer   String?  // peut être vide seulement si isNotApplicable = true
  isNotApplicable     Boolean @default(false)
  notApplicableReason String? // requis si isNotApplicable = true
  category String?
  answeredAt DateTime // date à laquelle la réponse est donnée/confirmée exacte

  status String @default("Brouillon") // 'Brouillon' | 'À valider' | 'Validé'
  validatedByName String?
  validatedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// Module G : gouvernance dirigeant — comités cyber et revue annuelle (preuve
// d'implication de la direction, NIS2 article 20). Même mécanique de validation
// tracée que les modules E et F : "Validé" n'est posé que par le client, nom et
// date fixés côté serveur.
model GovernanceMeeting {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type        String   @default("Comité") // 'Comité' | 'Revue annuelle'
  title       String
  meetingDate DateTime
  attendees   String?  // texte libre : noms et fonctions des participants
  summary     String?  // compte rendu : sujets abordés, décisions prises

  status String @default("Brouillon") // 'Brouillon' | 'À valider' | 'Validé'
  validatedByName String?
  validatedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// Module G : preuve de formation cybersécurité des dirigeants (NIS2 article 20 :
// les organes de direction doivent suivre une formation). Pas de fichier stocké :
// un lien vers l'attestation, comme ailleurs dans l'application.
model LeadershipTraining {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  participantName String
  role            String? // fonction du dirigeant formé (ex. "Président", "DG")
  trainingTitle   String
  completedAt     DateTime
  evidenceLink    String? // lien vers l'attestation / feuille d'émargement

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// Module H : registre des fournisseurs (risque tiers / chaîne d'approvisionnement,
// NIS2 article 21 — mesures de sécurité de la chaîne d'approvisionnement). Même
// mécanique que le module B (Control/Evidence) : un fournisseur porte des preuves
// annuelles datées, l'alerte avant expiration est calculée à la volée, jamais stockée.
model Supplier {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?  // service ou prestation fournie
  dataLocation String?  // localisation des données traitées/hébergées par ce fournisseur
  criticality String   @default("Moyenne") // 'Faible' | 'Moyenne' | 'Haute' | 'Critique'
  hasSecurityClause       Boolean @default(false)
  securityClauseReference String? // référence/lien vers la clause de sécurité du contrat
  lastReviewDate DateTime? // dernière revue de sécurité de ce fournisseur
  status      String   @default("Actif") // 'Actif' | 'Inactif'

  evidences SupplierEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// Preuve annuelle rattachée à un fournisseur (ex. certification, rapport d'audit du
// sous-traitant, attestation). Pas de fichier stocké : un lien, comme ailleurs.
model SupplierEvidence {
  id             String   @id @default(uuid())
  supplierId     String
  supplier       Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  organizationId String   // dénormalisé : cloisonnement direct sans jointure jusqu'à Supplier

  label        String
  evidenceDate DateTime  // date de la preuve elle-même
  expiresAt    DateTime?
  link         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([supplierId])
  @@index([expiresAt])
}
