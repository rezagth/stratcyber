{
  "name": "stratcyber",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "postinstall": "prisma generate",
    "setup-env": "node scripts/setup-env.js",
    "setup-hooks": "node scripts/setup-hooks.js",
    "switch-to-dev": "git checkout dev && npm run setup-env",
    "switch-to-master": "git checkout master && npm run setup-env",
    "safe-commit": "node scripts/safe-commit.js",
    "ebooks:sync": "node scripts/sync-ebooks.js",
    "ebooks:watch": "nodemon --watch ebooks/ --ext md,yaml --exec \"npm run ebooks:sync\"",
    "ebooks:validate": "node scripts/validate-ebooks.js",
    "ebooks:migrate": "node scripts/migrate-ebooks.js"
  },
